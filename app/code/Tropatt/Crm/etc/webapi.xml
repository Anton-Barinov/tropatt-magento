<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <!-- Inbound CRM webhook. Anonymous: the request is authenticated by the HMAC signature. -->
    <route url="/V1/tropatt/webhook" method="POST">
        <service class="Tropatt\Crm\Api\WebhookInterface" method="execute"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
</routes>
